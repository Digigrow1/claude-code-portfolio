# Copy to .env and fill in. .env is git-ignored; never commit real tokens.

# --- ngrok (required for the public URL) ---
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional extra flags, e.g. a free static domain from the ngrok dashboard:
# NGROK_ARGS=--url=your-name.ngrok-free.app
NGROK_ARGS=

# --- Local port for nginx ---
WEB_PORT=8080

# --- Phase switches (build-time; rebuild after changing) ---
# static | api
VITE_DATA_SOURCE=static
# mailto | api   (Phase 2 sets this to api)
VITE_CONTACT_MODE=mailto
VITE_API_BASE_URL=/api
